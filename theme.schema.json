{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio Theme",
  "description": "A theme combines a layout and a palette. Layouts define structure; palettes define colors/fonts/effects.",
  "type": "object",
  "required": ["name", "layout", "palette"],
  "properties": {
    "name":    { "type": "string", "description": "Unique theme identifier (kebab-case)" },
    "label":   { "type": "string", "description": "Human-readable name" },
    "layout":  { "type": "string", "description": "Name of layout in themes/layouts/" },
    "palette": { "type": "string", "description": "Name of palette in themes/palettes/" },
    "overrides": {
      "type": "object",
      "description": "Optional overrides merged on top of layout + palette"
    }
  }
}
